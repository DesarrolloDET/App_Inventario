# ============================================
# MEJIA TURNOS - Plantilla de variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA subas .env a Git.
# ============================================

# --- Entorno ---
# Valores permitidos: development | staging | production
APP_ENV=development

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mejia_turnos
DB_USER=postgres
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_64_BYTES

# Algoritmo JWT. HS256 es suficiente para MVP con secreto compartido.
JWT_ALGORITHM=HS256

# Duracion del access token en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30
